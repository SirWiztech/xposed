# XPOSED — AI chat config. Copy to `.env` and fill in your real key.
# The `.env` file is gitignored and blocked from the web by .htaccess.

# Google AI Studio (Gemini) API key — https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# Model id (see ai.google.dev). NOTE: gemini-2.5-flash-image is quota-blocked (429) on the current key.
GOOGLE_AI_MODEL=gemini-2.5-flash-image

# --- SEO / social ---
# Public site URL (used for canonicals, Open Graph and the sitemap).
# Leave empty in local dev (auto-derived from the request host).
XPOSED_SITE_URL=

# Default Open Graph / share image (site-relative or absolute).
# XPOSED_OG_IMAGE=

# Twitter handle shown in twitter:site.
# XPOSED_TWITTER_HANDLE=@Xposed