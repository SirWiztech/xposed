# XPOSED — environment template. Copy to `.env` and fill in your real values.
# The `.env` file is gitignored and blocked from the web by .htaccess.
# Every secret lives here (database credentials, API keys) — never in config/.

# --- Database credentials (ALL DB secrets live here) ---
# Read by config/config.php → PDO. No DB secrets are hardcoded in the repo.
# Precedence: XPOSED_DB_* wins; otherwise the vars Wasmer injects for its
# auto-provisioned MySQL (DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_USERNAME
# / DB_PASSWORD) are used; last resort is the WAMP-local 127.0.0.1 defaults.
# On a remote host set XPOSED_DB_HOST to the MySQL host shown in the hosting
# dashboard (Wasmer, e.g. db.<region>.<cluster>.wasmernet.com — NOT 127.0.0.1).
XPOSED_DB_HOST=127.0.0.1
XPOSED_DB_PORT=3306
XPOSED_DB_NAME=your_database_name
XPOSED_DB_USER=your_database_user
XPOSED_DB_PASS=your_database_password

# --- App ---
# Base path: "/xposed" on WAMP subfolder, "/" at the domain root.
# XPOSED_BASE_URL=
# XPOSED_APP_KEY=change-me-2026
# XPOSED_ENV=production
# XPOSED_DEBUG=0

# --- Runtime (InfinityFree "phpix") ---
# Pin the PHP version the phpix worker runs (e.g. 8.2). See InfinityFree
# docs for supported versions. This app requires PHP 8+. The port shown in the
# panel can be pinned via SHIPIT_PORT if a non-standard one is assigned.
SHIPIT_PHP_VERSION=8.2
# SHIPIT_PORT=

# --- Google AI Studio (Gemini) API key — https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# Model id (see ai.google.dev). NOTE: gemini-2.5-flash-image is quota-blocked (429) on the current key.
GOOGLE_AI_MODEL=gemini-2.5-flash-image

# --- SEO / social ---
# Public site URL (used for canonicals, Open Graph and the sitemap).
# Leave empty in local dev (auto-derived from the request host).
XPOSED_SITE_URL=

# Default Open Graph / share image (site-relative or absolute).
# XPOSED_OG_IMAGE=

# Twitter handle shown in twitter:site.
# XPOSED_TWITTER_HANDLE=@Xposed