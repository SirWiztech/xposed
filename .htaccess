# XPOSED — root access rules (additive; no rewrite rules that alter routing)

# Serve robots.txt / sitemap.xml from their dynamic PHP generators.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^robots\.txt$ robots.php [L]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Root favicon/icon probes → assets (avoid host error-page 403 noise).
  RewriteRule ^favicon\.ico$ assets/favicon.ico [L]
  RewriteRule ^apple-touch-icon\.png$ assets/apple-touch-icon.png [L]
</IfModule>

# Block direct web access to secret/dot files (.env etc.)
<IfModule mod_authz_core.c>
  <FilesMatch "^\.env">
    Require all denied
  </FilesMatch>
  <FilesMatch "^\.git">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^\.env|^\.git">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>